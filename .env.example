# Copy to .env for local development. On Vercel set these in Project Settings → Environment Variables.
# Nuxt maps NUXT_* variables onto runtimeConfig keys declared in nuxt.config.ts.

# Step 3.1: LLM via OpenRouter
NUXT_OPENROUTER_API_KEY=
NUXT_OPENROUTER_MODEL=
# Comma-separated list of fallback model ids
NUXT_OPENROUTER_FALLBACK_MODELS=

# Step 3.3: rate limits (Upstash Redis). Without them limits are disabled locally
NUXT_UPSTASH_REDIS_REST_URL=
NUXT_UPSTASH_REDIS_REST_TOKEN=
NUXT_DAILY_LLM_LIMIT=500

# Step 4.3: leads to Telegram
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=

# Step 6.1: public site URL for SEO and absolute hreflang links
NUXT_PUBLIC_SITE_URL=
