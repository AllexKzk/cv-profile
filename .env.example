# Copy to .env for local development. On Vercel set these in Project Settings → Environment Variables.
# Nuxt maps NUXT_* variables onto runtimeConfig keys declared in nuxt.config.ts.

# F3: LLM via OpenRouter. Set a credit limit on the key in OpenRouter settings.
NUXT_OPENROUTER_API_KEY=
# Defaults live in nuxt.config.ts; set these only to switch models without a code change
# NUXT_OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Comma-separated list of fallback model ids
# NUXT_OPENROUTER_FALLBACK_MODELS=openai/gpt-6-luna,deepseek/deepseek-v4.1-flash

# F3: rate limits (Upstash Redis). Without Redis the limits are disabled (local development).
# On Vercel the Upstash integration creates KV_REST_API_URL / KV_REST_API_TOKEN, which are
# picked up when these two are empty.
NUXT_UPSTASH_REDIS_REST_URL=
NUXT_UPSTASH_REDIS_REST_TOKEN=
# Requests per IP per 10 minutes, spend per IP per UTC day (USD), LLM requests per UTC day
NUXT_IP_REQUEST_LIMIT=15
NUXT_IP_DAILY_BUDGET_USD=1
NUXT_DAILY_LLM_LIMIT=500

# F4: leads to Telegram. Token from @BotFather, chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=
# Sent leads per IP and for the whole site per UTC day
NUXT_LEAD_IP_DAILY_LIMIT=1
NUXT_LEAD_DAILY_LIMIT=20

# F7: public site URL for SEO and absolute hreflang links
NUXT_PUBLIC_SITE_URL=
